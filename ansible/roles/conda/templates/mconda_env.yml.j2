# mconda_env.yml - generated by Ansible, do not edit manually
# Environment: {{ api_conda_env }} in {{ api_conda_base }}/envs/{{ api_conda_env }}
# Used with: conda env update -p <path> -f <this_file> --prune
# The 'name' field is ignored when using -p (absolute path)
channels:
  - conda-forge
  - defaults
dependencies:
  - python=3.11
{% for pkg in conda_packages %}
  - {{ pkg }}
{% endfor %}
  - pip
  - pip:
{% if pip_packages | length > 0 %}
{% for ppkg in pip_packages %}
      - {{ ppkg }}
{% endfor %}
{% else %}
      []
{% endif %}
