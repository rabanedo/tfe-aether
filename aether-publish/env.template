# =============================================================================
# /opt/nombre_aplicacion/.env — Credenciales del Nodo 2 (publicación GeoServer)
#
# Este fichero contiene credenciales. Permisos recomendados:
#     sudo chmod 600 /opt/nombre_aplicacion/.env
#     sudo chown root:root /opt/nombre_aplicacion/.env
#
# Usar este fichero como plantilla: copiar a .env y rellenar los valores.
# =============================================================================

# --- GeoServer REST API -------------------------------------------------------
CDSE_GEOSERVER_USER=usuario_geoserver
CDSE_GEOSERVER_PASS=tu_contraseña_segura

# URL del endpoint REST. El placeholder *coverage_name* se sustituye en tiempo
# de ejecución por el nombre de cada producto (s2ndvi, s2rgb).
# Para stores GeoTIFF individuales:
CDSE_GEOSERVER_REST_URL=http://localhost:8080/geoserver/rest/workspaces/nombre_workspace/coveragestores/*coverage_name*/external.geotiff
# Para stores ImageMosaic (descomentar y comentar la línea anterior):
#CDSE_GEOSERVER_REST_URL=http://localhost:8080/geoserver/rest/workspaces/nombre_workspace/coveragestores/*coverage_name*/external.imagemosaic

# --- Rutas -------------------------------------------------------------------
# Directorio raíz donde el Nodo 1 deposita los productos procesados.
# Debe coincidir con geoserver_products_path de config.txt del Nodo 1.
CDSE_GEOSERVER_PRODUCTS_PATH=ruta_a_los_productos_procesados
